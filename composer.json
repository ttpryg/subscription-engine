{
    "name": "ttpryg/subscription-engine",
    "description": "Framework-agnostic PHP 8.1+ Subscription, Recurring Billing, and Plan Management Engine",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Toto",
            "email": "totoprayogo1916@gmail.com",
            "homepage": "https://ttpryg.my.id"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "psr/event-dispatcher": "^1.0",
        "ttpryg/event-dispatcher": "^1.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "phpunit/phpunit": "^10.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "Ttpryg\\SubscriptionEngine\\": "src/",
            "Ttpryg\\SubscriptionEngine\\Infrastructure\\": "infrastructure/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ttpryg\\SubscriptionEngine\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "fix:check": [
            "vendor/bin/rector process --dry-run",
            "vendor/bin/pint --test"
        ],
        "fix": [
            "vendor/bin/rector process",
            "vendor/bin/pint"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
